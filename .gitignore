# data & big artifacts never go in git (paths set via BER_DATA_DIR / BER_ARTIFACTS)
data/
artifacts/
*.parquet
*.npy
*.npz
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.onnx
*.zip
# planner snapshot (regenerated by scripts/collect.py)
sync/
# smoke-test results
results/*/smoke/
# final outputs are committed deliberately with `git add -f output/*.tsv`
output/*.tsv
# python / editors
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
.vscode/
.idea/
.DS_Store
.claude/settings.local.json
